# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
env/
myenv/
.env/
.venv/
ENV/

# ── Distribution / packaging ───────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# ── Model checkpoints & weights ───────────────────────────────────────────────
# Training writes 10 MB+ weight files to checkpoints/ — reproducible, never push.
# The ONE exception is the canonical weight shipped inside the wheel
# (khmer_id_parser/assets/), which is re-included by the negation below.
*.pth
*.pt
*.ckpt
*.safetensors
!khmer_id_parser/assets/*.pth

# Keep the training metrics log and placeholder; ignore other checkpoint contents.
!checkpoints/training_metrics.json
!checkpoints/.gitkeep

# ── Data files ────────────────────────────────────────────────────────────────
# Generated train/val sets (rebuild via scripts/build_dataset.py) — large & reproducible.
train_clean.jsonl
val_clean.jsonl
*_clean.jsonl


# ── Generated plots ───────────────────────────────────────────────────────────
checkpoints/*.png
checkpoints/*.pdf
# Allow exactly one committed example plot for the README (explicit path so the
# basename doesn't accidentally re-include the other generated plots).
!checkpoints/training_summary.png

# ── Jupyter notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS & editor noise ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
.Spotlight-V100
.Trashes

.idea/
.vscode/
*.swp
*.swo
*~

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
.env
